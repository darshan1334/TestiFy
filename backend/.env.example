# ============================================================
# TestiFy Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Google Gemini API Key — primary AI provider (NEVER expose to frontend)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-3.6-flash

# Groq — optional automatic fallback used when Gemini is rate-limited
# or out of quota. Leave blank to disable the fallback.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./testify.db

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max pages to crawl per session
MAX_CRAWL_PAGES=10

# Screenshot directory (relative to backend/)
SCREENSHOT_DIR=screenshots

# Log level
LOG_LEVEL=INFO
